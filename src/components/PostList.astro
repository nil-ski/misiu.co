---
import { formatDate, type Post } from '../lib/posts';

interface Props {
  posts: Post[];
}
const { posts } = Astro.props;
const accents = ['var(--coral)', 'var(--sky)', 'var(--mint)', 'var(--lilac)', 'var(--lemon)'];
---

<ol class="posts">
  {
    posts.map((post, i) => (
      <li style={`--dot:${accents[i % accents.length]}`}>
        <a href={`/writing/${post.id}`}>
          <time datetime={post.date.toISOString()}>{formatDate(post.date, 'short')}</time>
          <span class="title">
            {post.title}
            {post.draft && <span class="draft">draft</span>}
          </span>
          {post.description && <span class="desc">{post.description}</span>}
        </a>
      </li>
    ))
  }
</ol>

<style>
  .posts {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  li + li {
    border-top: 1px solid var(--line);
  }

  a {
    display: grid;
    grid-template-columns: 7.5rem 1fr;
    column-gap: 1.5rem;
    row-gap: 0.25rem;
    padding: 1.35rem 1rem;
    margin-inline: -1rem;
    border-radius: var(--radius);
    text-decoration: none;
    position: relative;
    transition: background 0.25s;
  }

  a:hover {
    background: color-mix(in srgb, var(--paper-2) 80%, transparent);
  }

  time {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--ink-faint);
    padding-top: 0.45rem;
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }

  time::before {
    content: '';
    flex: none;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--dot);
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  a:hover time::before {
    transform: scale(1.6);
  }

  .title {
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 540;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }

  .desc {
    grid-column: 2;
    color: var(--ink-soft);
    font-size: 0.95rem;
  }

  .draft {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    vertical-align: middle;
    margin-left: 0.5rem;
    padding: 0.15rem 0.45rem;
    border-radius: 999px;
    background: var(--lemon);
  }

  @media (max-width: 36rem) {
    a {
      grid-template-columns: 1fr;
    }
    .desc {
      grid-column: 1;
    }
    time {
      padding-top: 0;
    }
  }
</style>
