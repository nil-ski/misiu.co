---
import { Image } from 'astro:assets';
import { formatDate } from '../lib/posts';
import type { Album } from '../lib/photos';

interface Props {
  album: Album;
  index?: number;
}
const { album, index = 0 } = Astro.props;
const tilt = [-2.2, 1.6, -1.2, 2.4][index % 4];
---

<a class="card" href={`/photos/${album.id}`} style={`--tilt:${tilt}deg`}>
  <span class="stack">
    <Image
      src={album.cover.image}
      alt={album.cover.alt}
      widths={[400, 640, 900]}
      sizes="(max-width: 40rem) 90vw, 22rem"
      class="cover"
    />
  </span>
  <span class="label">
    <span class="title">{album.title}</span>
    <span class="meta">{formatDate(album.date, 'short')} · {album.photos.length} photos</span>
  </span>
</a>

<style>
  .card {
    display: block;
    text-decoration: none;
  }

  /* A little stack of prints that fans out on hover */
  .stack {
    position: relative;
    display: block;
    aspect-ratio: 4 / 3;
    isolation: isolate;
  }

  .stack::before,
  .stack::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 0.6rem;
    background: #fff;
    box-shadow: 0 1px 3px rgb(29 27 24 / 0.12);
    z-index: -1;
    transition: rotate 0.45s cubic-bezier(0.34, 1.56, 0.64, 1), translate 0.45s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .stack::before {
    rotate: calc(var(--tilt) * -1.4);
  }
  .stack::after {
    rotate: var(--tilt);
    background: var(--paper-2);
  }

  .cover {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 0.6rem;
    border: 6px solid #fff;
    box-shadow: 0 10px 30px -12px rgb(29 27 24 / 0.35);
    transition: transform 0.45s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .card:hover .cover {
    transform: translateY(-4px) rotate(calc(var(--tilt) * -0.4));
  }
  .card:hover .stack::before {
    rotate: calc(var(--tilt) * -3.2);
    translate: -8px 4px;
  }
  .card:hover .stack::after {
    rotate: calc(var(--tilt) * 2.6);
    translate: 8px 2px;
  }

  .label {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    margin-top: 1rem;
  }

  .title {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 500;
    line-height: 1.2;
  }

  .meta {
    font-style: italic;
    font-size: 0.9rem;
    color: var(--ink-faint);
  }
</style>
