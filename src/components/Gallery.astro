---
import { Image, getImage } from 'astro:assets';
import { formatExif, type Photo } from '../lib/photos';
import { formatDate } from '../lib/posts';

interface Props {
  photos: Photo[];
  title: string;
}
const { photos, title } = Astro.props;

const items = await Promise.all(
  photos.map(async (photo) => {
    const large = await getImage({ src: photo.image, width: Math.min(2400, photo.image.width), format: 'webp' });
    return { photo, large: large.src, ratio: photo.image.width / photo.image.height };
  }),
);
---

<div class="gallery">
  {
    items.map(({ photo, large, ratio }, i) => (
      <a
        id={`photo-${photo.id}`}
        class="tile"
        href={large}
        style={`--ar:${ratio.toFixed(4)}`}
        data-index={i}
        data-caption={photo.exif.caption ?? ''}
        data-exif={formatExif(photo.exif).join(' · ')}
        data-taken={photo.exif.taken ? formatDate(photo.exif.taken) : ''}
      >
        <Image
          src={photo.image}
          alt={photo.alt}
          widths={[480, 800, 1200, 1600]}
          sizes={`(max-width: 40rem) 100vw, ${Math.round(ratio * 22)}rem`}
          loading={i < 4 ? 'eager' : 'lazy'}
        />
      </a>
    ))
  }
</div>

<dialog class="lightbox" aria-label={`${title} — photo viewer`}>
  <div class="bar">
    <span class="count"></span>
    <button class="close" type="button" autofocus>Close</button>
  </div>
  <figure>
    <img alt="" />
    <figcaption>
      <span class="caption"></span>
      <span class="exif"></span>
    </figcaption>
  </figure>
  <div class="nav-row">
    <button class="nav prev" type="button">← Previous</button>
    <button class="nav next" type="button">Next →</button>
  </div>
</dialog>

<script>
  for (const gallery of document.querySelectorAll<HTMLElement>('.gallery')) {
    const dialog = gallery.nextElementSibling as HTMLDialogElement;
    const tiles = [...gallery.querySelectorAll<HTMLAnchorElement>('.tile')];
    const img = dialog.querySelector('img')!;
    const caption = dialog.querySelector('.caption')!;
    const exif = dialog.querySelector('.exif')!;
    const count = dialog.querySelector('.count')!;
    let current = 0;

    const show = (index: number) => {
      current = (index + tiles.length) % tiles.length;
      const tile = tiles[current];
      const thumb = tile.querySelector('img')!;
      img.src = tile.href;
      img.alt = thumb.alt;
      caption.textContent = tile.dataset.caption ?? '';
      exif.textContent = [tile.dataset.exif, tile.dataset.taken].filter(Boolean).join(' · ');
      count.textContent = `${current + 1} / ${tiles.length}`;
      history.replaceState(null, '', `#${tile.id}`);
    };

    const open = (index: number) => {
      show(index);
      if (!dialog.open) dialog.showModal();
    };

    tiles.forEach((tile, i) =>
      tile.addEventListener('click', (event) => {
        if (event.metaKey || event.ctrlKey || event.shiftKey) return;
        event.preventDefault();
        open(i);
      }),
    );

    dialog.querySelector('.prev')!.addEventListener('click', () => show(current - 1));
    dialog.querySelector('.next')!.addEventListener('click', () => show(current + 1));
    dialog.querySelector('.close')!.addEventListener('click', () => dialog.close());
    dialog.addEventListener('close', () => history.replaceState(null, '', location.pathname));
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') show(current - 1);
      if (event.key === 'ArrowRight') show(current + 1);
    });

    let touchX = 0;
    dialog.addEventListener('touchstart', (e) => (touchX = e.touches[0].clientX), { passive: true });
    dialog.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - touchX;
      if (Math.abs(dx) > 50) show(current + (dx < 0 ? 1 : -1));
    });

    // Deep links: /photos/album#photo-3 opens that photo
    const linked = tiles.findIndex((tile) => `#${tile.id}` === location.hash);
    if (linked >= 0) open(linked);
  }
</script>

<style>
  /* Justified rows: every tile keeps its aspect ratio, rows fill the width. */
  .gallery {
    --row: 14rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .gallery::after {
    content: '';
    flex-grow: 999999;
  }

  .tile {
    flex-grow: calc(var(--ar) * 100);
    flex-basis: calc(var(--ar) * var(--row));
    background: var(--tint);
    cursor: zoom-in;
  }

  .tile img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: var(--ar);
    object-fit: cover;
  }

  @media (max-width: 40rem) {
    .gallery {
      --row: 8rem;
      gap: 0.25rem;
    }
  }

  /* Lightbox: a plain white page with the photo */
  .lightbox {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--paper);
    color: var(--ink);
  }

  .lightbox[open] {
    display: grid;
    grid-template-rows: auto 1fr auto;
  }

  .bar {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding: 0.75rem var(--gutter);
  }

  figure {
    margin: 0;
    min-height: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    padding: 0 var(--gutter);
  }

  figure img {
    max-width: 100%;
    max-height: calc(100dvh - 11rem);
    width: auto;
    height: auto;
    object-fit: contain;
  }

  figcaption {
    text-align: center;
    min-height: 2.6rem;
  }

  .caption {
    display: block;
  }

  .exif,
  .count {
    display: block;
    font-size: 0.85rem;
    color: var(--ink-faint);
  }

  .nav-row {
    display: flex;
    justify-content: space-between;
    padding: 0.75rem var(--gutter) 1rem;
  }

  /* Buttons that look like links */
  button {
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    color: var(--link);
    text-decoration: underline;
    cursor: pointer;
  }
</style>
