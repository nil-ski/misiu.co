---
/**
 * A ski trail carving between slalom gates, drawn on load.
 * The signature doodle of nil.ski.
 */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;

const gates = [
  { x: 150, y: 58, color: 'var(--coral)' },
  { x: 390, y: 122, color: 'var(--sky)' },
  { x: 640, y: 50, color: 'var(--coral)' },
  { x: 880, y: 118, color: 'var(--sky)' },
];
---

<svg class:list={['trail', className]} viewBox="0 0 1040 170" fill="none" aria-hidden="true">
  <path
    class="track"
    d="M10 30 C 90 30, 110 110, 190 104 S 330 60, 380 72 S 540 150, 600 104 S 700 30, 800 64 S 950 150, 1030 132"
    pathLength="1"></path>
  {
    gates.map((gate, i) => (
      <g class="gate" style={`--i:${i}; --gate:${gate.color}`} transform={`translate(${gate.x} ${gate.y})`}>
        <line x1="0" y1="0" x2="0" y2="-34" />
        <path d="M0 -34 L 20 -27 L 0 -20 Z" />
      </g>
    ))
  }
</svg>

<style>
  .trail {
    display: block;
    width: 100%;
    overflow: visible;
  }

  .track {
    stroke: var(--ink);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: carve 2.4s 0.2s cubic-bezier(0.6, 0.05, 0.25, 1) forwards;
  }

  .gate line {
    stroke: var(--ink);
    stroke-width: 2;
    stroke-linecap: round;
  }

  .gate path {
    fill: var(--gate);
  }

  .gate {
    opacity: 0;
    transform-box: fill-box;
    transform-origin: bottom center;
    animation: plant 0.5s calc(0.5s + var(--i) * 0.45s) cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
  }

  @keyframes carve {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes plant {
    from {
      opacity: 0;
      scale: 1 0.2;
    }
    to {
      opacity: 1;
      scale: 1 1;
    }
  }
</style>
