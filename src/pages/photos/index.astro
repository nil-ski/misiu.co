---
import Base from '../../layouts/Base.astro';
import AlbumCard from '../../components/AlbumCard.astro';
import { getAlbums } from '../../lib/photos';

const albums = await getAlbums();
const total = albums.reduce((sum, album) => sum + album.photos.length, 0);
---

<Base title="Photos" description="Photo albums — mostly places, light and the odd street corner.">
  <section class="wrap intro">
    <p class="eyebrow">Photos</p>
    <h1>Through the <span class="mark" style="--mark: color-mix(in srgb, var(--sky) 45%, white)">viewfinder</span></h1>
    <p class="lede">{albums.length} albums, {total} photos.</p>
  </section>

  <div class="wrap albums">
    {albums.map((album, i) => <AlbumCard album={album} index={i} />)}
  </div>
</Base>

<style>
  .intro {
    padding-block: clamp(2.5rem, 8vw, 5rem) 1.5rem;
  }
  h1 {
    font-size: clamp(2.6rem, 7vw, 4.5rem);
    letter-spacing: -0.035em;
    font-variation-settings: 'SOFT' 100, 'WONK' 1, 'opsz' 144;
    margin: 0.4rem 0 0;
  }
  .lede {
    color: var(--ink-soft);
  }
  .albums {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
    gap: clamp(2rem, 5vw, 3.5rem) clamp(1.5rem, 4vw, 3rem);
    margin-top: 1.5rem;
  }
</style>
