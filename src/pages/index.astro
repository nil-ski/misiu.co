---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import AlbumCard from '../components/AlbumCard.astro';
import { getPosts } from '../lib/posts';
import { getAlbums } from '../lib/photos';

const posts = (await getPosts()).slice(0, 5);
const albums = (await getAlbums()).slice(0, 3);
---

<Base>
  <section class="wrap hero">
    <p class="eyebrow">
      <span lang="sv">Hej</span> · <span lang="pl">Cześć</span> · Hi — I'm Nils
    </p>
    <h1>
      I write about <span class="mark">making things</span>, the tools I use, and the photos I take
      <em>along the way</em>.
    </h1>
    <p class="name-note">
      Swedish name, Polish roots — <a href="/about#the-name">why nil.ski?</a>
    </p>
  </section>

  <section class="wrap latest">
    <header>
      <h2>Latest writing</h2>
      <a href="/writing">All posts →</a>
    </header>
    {posts.length ? <PostList posts={posts} /> : <p class="empty">Nothing here yet — first post coming soon.</p>}
  </section>

  {
    albums.length > 0 && (
      <section class="wrap latest">
        <header>
          <h2>Recent photos</h2>
          <a href="/photos">All albums →</a>
        </header>
        <div class="albums">
          {albums.map((album, i) => (
            <AlbumCard album={album} index={i} />
          ))}
        </div>
      </section>
    )
  }
</Base>

<style>
  .hero {
    padding-block: clamp(3rem, 10vw, 7rem) clamp(1rem, 4vw, 3rem);
  }

  h1 {
    font-size: clamp(2.4rem, 6.2vw, 5rem);
    font-weight: 480;
    line-height: 1.04;
    letter-spacing: -0.03em;
    word-spacing: 0.04em;
    max-width: 16ch;
    margin: 0.5rem 0 0;
    font-variation-settings: 'SOFT' 100, 'WONK' 1, 'opsz' 144;
  }

  h1 em {
    font-style: italic;
    padding-inline: 0.14em 0.12em;
    color: var(--sky);
  }

  .name-note {
    margin: 1.5rem 0 0;
    color: var(--ink-soft);
    font-size: 0.95rem;
  }

  .latest {
    margin-top: clamp(2rem, 6vw, 4rem);
  }

  .latest header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.5rem;
  }

  .latest h2 {
    font-size: 1.1rem;
    font-family: var(--font-mono);
    font-weight: 500;
    letter-spacing: 0.02em;
    margin: 0;
  }

  .latest header a {
    font-size: 0.92rem;
    color: var(--ink-soft);
  }

  .albums {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
    gap: 2rem clamp(1.5rem, 4vw, 3rem);
    margin-top: 1.5rem;
  }

  .empty {
    color: var(--ink-faint);
  }
</style>
