---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" description="This page doesn't exist.">
  <section class="wrap lost">
    <p class="eyebrow">404</p>
    <h1>This page got <em>lost</em>.</h1>
    <p>It doesn't exist, or it moved. Let's get you <a href="/">back home</a>.</p>
  </section>
</Base>

<style>
  .lost {
    padding-block: clamp(3rem, 10vw, 7rem);
  }
  h1 {
    font-size: clamp(2.6rem, 7vw, 4.5rem);
    letter-spacing: -0.035em;
    margin: 0.4rem 0 1rem;
  }
  em {
    color: var(--coral);
  }
</style>
