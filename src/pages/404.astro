---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" description="This page doesn't exist.">
  <section class="measure lost">
    <h1>This page got <em>lost</em>.</h1>
    <p>It doesn't exist, or it moved. Let's get you <a href="/">back home</a>.</p>
  </section>
</Base>

<style>
  .lost {
    padding-block: clamp(3rem, 10vw, 7rem);
  }
  h1 {
    font-size: clamp(2.2rem, 6vw, 3.1rem);
    font-variation-settings: 'SOFT' 100, 'WONK' 1;
    margin: 0 0 1rem;
  }
  em {
    color: var(--coral);
  }
</style>
