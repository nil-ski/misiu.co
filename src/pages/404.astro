---
import Base from '../layouts/Base.astro';
import SlalomTrail from '../components/SlalomTrail.astro';
---

<Base title="Off piste" description="This page doesn't exist.">
  <section class="wrap lost">
    <p class="eyebrow">404</p>
    <h1>You've gone <em>off piste</em>.</h1>
    <p>That page doesn't exist. Let's get you <a href="/">back on the trail</a>.</p>
    <SlalomTrail />
  </section>
</Base>

<style>
  .lost {
    padding-block: clamp(3rem, 10vw, 7rem);
  }
  h1 {
    font-size: clamp(2.6rem, 7vw, 4.5rem);
    letter-spacing: -0.035em;
    margin: 0.4rem 0 1rem;
  }
  em {
    color: var(--coral);
  }
</style>
