---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { formatDate, getPosts, type Post } from '../../lib/posts';
import '../../styles/prose.css';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

interface Props {
  post: Post;
  newer?: Post;
  older?: Post;
}

const { post, newer, older } = Astro.props;
const { Content } = await render(post.entry);
---

<Base title={post.title} description={post.description} type="article">
  <meta slot="head" property="article:published_time" content={post.date.toISOString()} />

  <article>
    <header class="measure post-header">
      <p class="meta">
        <time datetime={post.date.toISOString()}>{formatDate(post.date)}</time>
        <span aria-hidden="true">·</span>
        <span>{post.readingMinutes} min read</span>
        {post.draft && <span class="draft">draft</span>}
      </p>
      <h1>{post.title}</h1>
      {
        post.tags.length > 0 && (
          <ul class="tags">
            {post.tags.map((tag) => (
              <li>#{tag}</li>
            ))}
          </ul>
        )
      }
    </header>

    <div class="measure prose">
      <Content />
    </div>
  </article>

  <nav class="measure pager" aria-label="More posts">
    {
      older ? (
        <a class="older" href={`/writing/${older.id}`}>← {older.title}</a>
      ) : (
        <span />
      )
    }
    {
      newer && (
        <a class="newer" href={`/writing/${newer.id}`}>{newer.title} →</a>
      )
    }
  </nav>
</Base>

<style>
  .post-header {
    margin-bottom: 1.5rem;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0 0 0.25rem;
  }

  h1 {
    margin: 0;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin: 0.5rem 0 0;
    color: var(--ink-faint);
    font-size: 0.95rem;
  }

  .draft {
    font-style: normal;
    color: #b00;
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 3rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }

  .newer {
    grid-column: 2;
    text-align: right;
  }
</style>
