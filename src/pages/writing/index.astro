---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { getPosts } from '../../lib/posts';

const posts = await getPosts();
const byYear = Map.groupBy(posts, (post) => post.date.getUTCFullYear());
---

<Base title="Writing" description="Everything I've written, newest first.">
  <section class="wrap intro">
    <p class="eyebrow">Archive</p>
    <h1>Writing</h1>
    <p class="lede">{posts.length} {posts.length === 1 ? 'post' : 'posts'}, newest first.</p>
  </section>

  <div class="wrap years">
    {
      [...byYear].map(([year, list]) => (
        <section class="year">
          <h2>{year}</h2>
          <PostList posts={list} />
        </section>
      ))
    }
  </div>
</Base>

<style>
  .intro {
    padding-block: clamp(2.5rem, 8vw, 5rem) 1rem;
  }
  h1 {
    font-size: clamp(2.6rem, 7vw, 4.5rem);
    margin: 0.4rem 0 0;
    letter-spacing: -0.035em;
  }
  .lede {
    color: var(--ink-soft);
  }
  .year {
    display: grid;
    grid-template-columns: 6rem 1fr;
    gap: 1rem;
    padding-block: 1.5rem;
  }
  .year + .year {
    border-top: 1px dashed var(--line);
  }
  .year h2 {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--ink-faint);
    margin: 1.55rem 0 0;
  }
  @media (max-width: 44rem) {
    .year {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }
</style>
