---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { getPosts } from '../../lib/posts';

const posts = await getPosts();
const byYear = Map.groupBy(posts, (post) => post.date.getUTCFullYear());
---

<Base title="Writing" description="Everything I've written, newest first.">
  <section class="measure intro">
    <h1>Writing</h1>
    <p class="lede">{posts.length} {posts.length === 1 ? 'post' : 'posts'}, newest first.</p>
  </section>

  <div class="measure years">
    {
      [...byYear].map(([year, list]) => (
        <section class="year">
          <h2>{year}</h2>
          <PostList posts={list} summaries />
        </section>
      ))
    }
  </div>
</Base>

<style>
  .intro {
    padding-block: clamp(2.5rem, 8vw, 4.5rem) 1rem;
  }
  h1 {
    font-size: clamp(2.2rem, 6vw, 3.1rem);
    font-variation-settings: 'SOFT' 100, 'WONK' 1;
    margin: 0;
  }
  .lede {
    margin: 0.4rem 0 0;
    font-style: italic;
    color: var(--ink-faint);
  }
  .year {
    padding-block: 1.25rem 0.5rem;
  }
  .year h2 {
    font-size: 1.1rem;
    color: var(--ink-faint);
    margin: 0 0 0.5rem;
  }
</style>
