# Photo bucket (any S3-compatible storage: Cloudflare R2, Backblaze B2, Amazon S3).
# Copy to .env for local use; set the same variables as secrets on the build server.
# Use a read-only key.
PHOTOS_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
PHOTOS_S3_BUCKET=nilski-photos
PHOTOS_S3_ACCESS_KEY_ID=
PHOTOS_S3_SECRET_ACCESS_KEY=
# PHOTOS_S3_REGION=auto
